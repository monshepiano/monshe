# ===== JARVIS — «мозги» (провайдеры) =====
# DeepSeek (по умолчанию, дёшево, работает из РФ без VPN)
DEEPSEEK_API_KEY=

# Vision-модель для камеры (у DeepSeek зрения нет)
# Выберите одну:
GOOGLE_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ===== Роутер: можно менять движок на лету =====
# JARVIS_FAST_PROVIDER=deepseek
# JARVIS_FAST_MODEL=deepseek-chat
# JARVIS_SMART_PROVIDER=deepseek
# JARVIS_SMART_MODEL=deepseek-reasoner
# JARVIS_VISION_PROVIDER=gemini
# JARVIS_VISION_MODEL=gemini-2.0-flash

# ===== Локальная модель (без API-ключей) =====
# OLLAMA_HOST=http://localhost:11434

# ===== Управление ПК (только на вашем компьютере) =====
# JARVIS_ENABLE_PC=1

# ===== Демо-режим без ключей =====
# JARVIS_MOCK=auto
