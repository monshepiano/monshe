limit_req_zone $binary_remote_addr zone=jarvis_images:10m rate=6r/m;

server {
    listen 80;
    listen [::]:80;
    server_name images.example.ru;

    client_max_body_size 16k;

    location = /health {
        proxy_pass http://127.0.0.1:8780/health;
        proxy_set_header Host $host;
    }

    location = /v1/images/generations {
        limit_req zone=jarvis_images burst=2 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:8780/v1/images/generations;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_read_timeout 300s;
        proxy_buffering off;
    }

    location / {
        return 404;
    }
}
