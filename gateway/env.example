# chmod 600 /etc/jarvis-image-gateway.env
# Recommended production upstream: Russian Timeweb AI Gateway. The key is
# stored only here and must never be inserted into JARVIS.command/JARVIS.zip.
JARVIS_IMAGE_UPSTREAM=timeweb
TIMEWEB_AI_GATEWAY_KEY=replace-with-timeweb-ai-gateway-key
TIMEWEB_IMAGE_MODEL=black_forest_labs/flux-2-pro
TIMEWEB_AI_GATEWAY_URL=https://api.timeweb.ai/v1
# HTTPS suffixes accepted only if the API falls back from Base64 to an asset URL.
TIMEWEB_IMAGE_HOSTS=timeweb.ai,timeweb.cloud

# Alternative upstream for a licence that permits service use:
# JARVIS_IMAGE_UPSTREAM=gigachat
# GIGACHAT_AUTH_KEY=replace-with-server-side-b2b-authorization-key
# GIGACHAT_SCOPE=GIGACHAT_API_B2B
# GIGACHAT_MODEL=GigaChat

# Generate at least 32 random bytes per release, for example:
# openssl rand -base64 32 | tr '/+' '_-'
JARVIS_GATEWAY_CLIENT_TOKENS=replace-with-revocable-release-token

JARVIS_GATEWAY_HOST=127.0.0.1
JARVIS_GATEWAY_PORT=8780
JARVIS_GATEWAY_TRUST_PROXY=1
JARVIS_GATEWAY_PER_MINUTE=4
JARVIS_GATEWAY_PER_DAY=40
JARVIS_GATEWAY_GLOBAL_PER_DAY=200
JARVIS_GATEWAY_CONCURRENCY=2
